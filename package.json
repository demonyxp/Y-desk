{
  "name": "y-desk",
  "version": "0.2.2",
  "description": "Windows 双显示器远程桌面，基于 WebRTC 的实时共享与控制",
  "private": true,
  "main": "src/main.cjs",
  "author": "demonyxp",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.cjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.cjs",
    "dist": "npm run build:native && electron-builder --win nsis portable --x64 --publish never",
    "pack": "npm run build:native && electron-builder --win --dir --x64"
  },
  "dependencies": { "ws": "8.22.0" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.demonyxp.ydesk",
    "productName": "Y-Desk",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/icon.ico", "package.json"],
    "extraResources": [{ "from": "native/bin/YDesk.Input.exe", "to": "native/YDesk.Input.exe" }],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.ico", "signExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Y-Desk-Setup-${version}-win-${arch}.${ext}"
    },
    "artifactName": "Y-Desk-${version}-win-${arch}.${ext}"
  }
}
